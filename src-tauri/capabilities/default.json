{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "init"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "core:window:allow-set-focus",
    "core:window:allow-create",
    "core:window:allow-show",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:webview:allow-create-webview-window",
    "dialog:default",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "sidecar": true,
          "args": true,
          "name": "binaries/fnm"
        },
        {
          "cmd": "node",
          "args": true,
          "name": "node"
        },
        {
          "cmd": "pnpm",
          "args": true,
          "name": "pnpm"
        },
        {
          "cmd": "npm",
          "args": true,
          "name": "npm"
        },
        {
          "cmd": "nrm",
          "args": true,
          "name": "nrm"
        }
      ]
    },
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": ["**"]
    },
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-read-text-file",
    "fs:allow-create",
    "fs:allow-write-text-file",
    "fs:allow-write",
    {
      "identifier": "http:default",
      "allow": ["https://*", "http://*"]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**",
          "app": true
        }
      ]
    },
    "os:default"
  ]
}
