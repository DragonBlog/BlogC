{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "core:window:allow-set-focus",
    "dialog:default",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "sidecar": true,
          "args": true,
          "name": "binaries/fnm"
        },
        {
          "cmd": "node",
          "args": true,
          "name": "node"
        },
        {
          "cmd": "pnpm",
          "args": true,
          "name": "pnpm"
        },
        {
          "cmd": "echo",
          "args": true,
          "name": "echo"
        }
      ]
    },
    "fs:default"
  ]
}
